# Copy to .env.local (git-ignored) and fill in. Used by the vite dev server, the backend, and docker compose.
CONTAINER_STATUS_URL=

# Backend (backend/)
# NetBox base URL and API token (read-only user); the backend is the only NetBox reader.
NETBOX_URL=
NETBOX_TOKEN=
# Optional: period in seconds of the NetBox / NPM cycle (default 300).
INVENTORY_PERIOD_S=
ROUTEROS_HOST=
ROUTEROS_PORT=8728
ROUTEROS_USER=
ROUTEROS_PASSWORD=
# Proxmox VE API (e.g. https://192.0.2.5:8006) and token `user@realm!id=secret`; Proxmox data is off unless both are set.
PROXMOX_URL=
PROXMOX_TOKEN=
# Optional: polling periods in seconds (cluster resources default 15, node load graphs default 60).
PROXMOX_PERIOD_S=
PROXMOX_METRICS_PERIOD_S=
# Optional: NetBox web UI base URL for links on the ARP page.
NETBOX_PUBLIC_URL=
# Optional: comma-separated check names (`parent/service`) that are never checked.
SERVICE_CHECK_EXCLUDE=
# Optional: Nginx Proxy Manager, for public (reverse-proxy) links of services; off unless all three are set.
# NPM_URL is the direct admin/API base, e.g. http://192.0.2.15:81; the user needs view rights on proxy hosts.
NPM_URL=
NPM_IDENTITY=
NPM_SECRET=
# Optional: seconds the backend keeps its upstream sessions after the last page disconnected (default 10).
STREAM_GRACE_S=
# Optional, dev server only: where the backend runs (default http://127.0.0.1:8000).
BACKEND_URL=
