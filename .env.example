# Copy to .env.local (git-ignored) and fill in. Used by the vite dev server, the backend, and docker compose.
NETBOX_URL=
NETBOX_TOKEN=
PROXMOX_URL=
PROXMOX_TOKEN=
CONTAINER_STATUS_URL=

# Backend (backend/)
ROUTEROS_HOST=
ROUTEROS_PORT=8728
ROUTEROS_USER=
ROUTEROS_PASSWORD=
# Optional: NetBox web UI base URL for links on the ARP page.
NETBOX_PUBLIC_URL=
# Optional: comma-separated check names (`parent/service`) that are never checked.
SERVICE_CHECK_EXCLUDE=
# Optional, dev server only: where the backend runs (default http://127.0.0.1:8000).
BACKEND_URL=
