server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Run the backend's polling sources at once (Refresh button): POST only.
    location = /api/refresh {
        limit_except POST {
            deny all;
        }
        proxy_pass http://api:8000/api/refresh;
    }

    # The page's event stream (Server-Sent Events), answered by the backend: GET only, never buffered.
    location = /api/stream {
        limit_except GET {
            deny all;
        }
        proxy_pass http://api:8000/api/stream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        # nginx consumes the backend's X-Accel-Buffering; re-send it so the outer reverse proxy does not buffer either.
        add_header X-Accel-Buffering no;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
