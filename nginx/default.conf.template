server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The only NetBox endpoint exposed: GraphQL, POST only.
    location = /netbox/graphql/ {
        limit_except POST {
            deny all;
        }
        proxy_pass ${NETBOX_URL}/graphql/;
        proxy_set_header Authorization "Bearer ${NETBOX_TOKEN}";
    }

    # Anything else under /netbox/ is not proxied.
    location /netbox/ {
        return 404;
    }

    # Proxmox cluster resources: GET only
    location = /proxmox/api2/json/cluster/resources {
        limit_except GET {
            deny all;
        }
        proxy_pass ${PROXMOX_URL}/api2/json/cluster/resources;
        proxy_set_header Authorization "PVEAPIToken=${PROXMOX_TOKEN}";
        proxy_ssl_verify off;
    }

    # Proxmox node rrddata: GET only
    location ~ ^/proxmox/api2/json/nodes/([^/]+)/rrddata$ {
        limit_except GET {
            deny all;
        }
        proxy_pass ${PROXMOX_URL}/api2/json/nodes/$1/rrddata$is_args$args;
        proxy_set_header Authorization "PVEAPIToken=${PROXMOX_TOKEN}";
        proxy_ssl_verify off;
    }

    # Anything else under /proxmox/ is not proxied.
    location /proxmox/ {
        return 404;
    }

    # Service status: GET only
    location = /api/service-status {
        limit_except GET {
            deny all;
        }
        proxy_pass ${SERVICE_STATUS_URL};
        proxy_ssl_verify off;
    }

    # Container status: GET only
    location = /api/container-status {
        limit_except GET {
            deny all;
        }
        proxy_pass ${CONTAINER_STATUS_URL};
        proxy_ssl_verify off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
