server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The only NetBox endpoint exposed: GraphQL, POST only.
    location = /netbox/graphql/ {
        limit_except POST {
            deny all;
        }
        proxy_pass ${NETBOX_URL}/graphql/;
        proxy_set_header Authorization "Bearer ${NETBOX_TOKEN}";
    }

    # Anything else under /netbox/ is not proxied.
    location /netbox/ {
        return 404;
    }

    # Proxmox cluster resources: GET only
    location = /proxmox/api2/json/cluster/resources {
        limit_except GET {
            deny all;
        }
        proxy_pass ${PROXMOX_URL}/api2/json/cluster/resources;
        proxy_set_header Authorization "PVEAPIToken=${PROXMOX_TOKEN}";
        proxy_ssl_verify off;
    }

    # Proxmox node rrddata: GET only
    location ~ ^/proxmox/api2/json/nodes/([^/]+)/rrddata$ {
        limit_except GET {
            deny all;
        }
        proxy_pass ${PROXMOX_URL}/api2/json/nodes/$1/rrddata$is_args$args;
        proxy_set_header Authorization "PVEAPIToken=${PROXMOX_TOKEN}";
        proxy_ssl_verify off;
    }

    # Anything else under /proxmox/ is not proxied.
    location /proxmox/ {
        return 404;
    }

    # Service status, answered by the backend: GET only
    location = /api/service-status {
        limit_except GET {
            deny all;
        }
        proxy_pass http://api:8000/api/service-status;
    }

    # ARP mirror (Server-Sent Events), answered by the backend: GET only, never buffered.
    location = /api/arp/stream {
        limit_except GET {
            deny all;
        }
        proxy_pass http://api:8000/api/arp/stream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        # nginx consumes the backend's X-Accel-Buffering; re-send it so the outer reverse proxy does not buffer either.
        add_header X-Accel-Buffering no;
    }

    # Container status: GET only
    location = /api/container-status {
        limit_except GET {
            deny all;
        }
        proxy_pass ${CONTAINER_STATUS_URL};
        proxy_ssl_verify off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
